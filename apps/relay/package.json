{
  "name": "@aeliqo/relay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": "24.20.0",
    "pnpm": "11.24.0"
  },
  "files": [
    "dist",
    "package.json"
  ],
  "scripts": {
    "build": "pnpm --workspace-root build:agent && tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tests/tsconfig.json",
    "test": "pnpm --workspace-root build:agent && vitest run --config vitest.config.mjs"
  },
  "dependencies": {
    "@aeliqo/agent": "workspace:*",
    "@aeliqo/core": "workspace:*",
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  }
}
