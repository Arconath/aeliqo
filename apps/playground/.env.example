# Required only for the built-in local BYOK composer.
AELIQO_MODEL_BASE_URL=https://api.openai.com/v1/
AELIQO_MODEL=your-tool-capable-model
AELIQO_MODEL_API_KEY=replace-in-your-local-shell

# Optional runner settings.
AELIQO_PLAYGROUND_PORT=4174
# AELIQO_MCP_TOKEN=replace-with-a-long-random-local-token
# AELIQO_ALLOW_INSECURE_MODEL_HTTP=1 # loopback model endpoints only
