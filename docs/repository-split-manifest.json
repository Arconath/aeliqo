    },
    {
      "sourcePath": "{packages/**,apps/studio/**,examples/**,harness/components.json,design/**,tests except site-only tests}",
      "destinationPath": "same relative paths in Arconath/aeliqo",
      "disposition": "retain-public",
      "reason": "The complete framework, local Studio/testkit, source examples, design contracts, security/accessibility, and conformance coverage remain Apache-2.0 OSS.",
      "dependencies": [
        "public pnpm-lock.yaml"
      ],
      "tests": [
        "public product command ledger",
        "public package consumer tests",
        "public browser and SSR/hydration tests"
      ],
      "provenance": "git:Arconath/aeliqo@fb16bc90965b117f77d7c09974eecdedf26d2f6a"
    },
    {
      "sourcePath": "{package.json,pnpm-lock.yaml,pnpm-workspace.yaml,tsconfig.json,tsconfig.lint.json}",
      "destinationPath": "independent root files in each repository",
      "disposition": "split-and-regenerate",
      "reason": "Each repository needs a standalone locked dependency graph; the private site may not use workspace links or a sibling checkout.",
      "dependencies": [
        "exact public candidate tarballs before npm availability",
        "exact registry versions after verified publication"
      ],
      "tests": [
        "fresh public clone install/build/test",
        "fresh private clone install/build/test",
        "lockfile integrity checks"
      ],
      "provenance": "generated from the two final package manifests; never copied as a shared mutable lockfile"
    },
    {
      "sourcePath": "harness/evidence/**",
      "destinationPath": "no bulk move",
      "disposition": "retain-public-history",
      "reason": "Historical evidence remains immutable; new site evidence is recorded in the private repository and public replacement gates get new OSS evidence.",
      "dependencies": [],
      "tests": [
        "fresh evidence references must bind the applicable repository SHA"
      ],
      "provenance": "existing Git history"
    }
