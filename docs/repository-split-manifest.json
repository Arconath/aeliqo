      "destinationPath": ".github/workflows/release.yml",
      "disposition": "move-private-and-rebind-authority",
      "reason": "Only the site repository may publish the production website image after cutover.",
      "dependencies": [
        "successful same-site-SHA private quality run",
        "owner dispatch",
        "GHCR package permission"
      ],
      "tests": [
        "private workflow policy tests",
        "server-side workflow run evidence"
