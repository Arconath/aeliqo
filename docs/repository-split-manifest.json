      "destinationPath": "split between both repositories",
      "disposition": "replace-by-independent-workflows",
      "reason": "Public SDK quality must remain GitHub-hosted and credential-free; private site quality owns its build, browser, server, and image checks.",
      "dependencies": [
        "public locked toolchain",
        "private vendored exact public inputs"
      ],
      "tests": [
        "public pnpm check",
        "public pnpm test:docs-artifact",
        "public release candidate consumer",
        "private full site gates"
      ],
      "provenance": "git:Arconath/aeliqo@fb16bc90965b117f77d7c09974eecdedf26d2f6a:.github/workflows/quality.yml"
    },
