{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aeliqo:reference:0.1:types",
  "title": "Aeliqo candidate structural types 0.1",
  "$defs": {
    "Id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:/@-]{0,127}$"
    },
    "Decimal": {
      "type": "string",
      "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
      "maxLength": 128
    },
    "Revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "JsonValue": {
      "anyOf": [
        {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        {
          "type": "array",
          "items": {
            "$ref": "urn:aeliqo:reference:0.1:types#/$defs/JsonValue"
          },
          "minItems": 0,
          "maxItems": 256
        },
        {
          "type": "object",
          "maxProperties": 128,
          "propertyNames": {
            "maxLength": 128
          },
          "additionalProperties": {
            "$ref": "urn:aeliqo:reference:0.1:types#/$defs/JsonValue"
          }
        }
      ]
    },
    "Props": {
      "type": "object",
      "maxProperties": 64,
      "propertyNames": {
        "maxLength": 128
      },
      "additionalProperties": {
        "$ref": "urn:aeliqo:reference:0.1:types#/$defs/JsonValue"
      }
    },
    "Unit": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "scalar"
            },
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "ratio"
            },
            "display": {
              "enum": [
                "fraction",
                "percent"
              ]
            },
            "denominatorMeaning": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            }
          },
          "required": [
            "kind",
            "display"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "currency"
            },
            "currency": {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            },
            "per": {
              "type": "object",
              "properties": {
                "quantity": {
                  "$ref": "urn:aeliqo:reference:0.1:types#/$defs/Decimal"
                },
                "unit": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                }
              },
              "required": [
                "quantity",
                "unit"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "kind",
            "currency"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "duration"
            },
            "unit": {
              "enum": [
                "ms",
                "s",
                "min",
                "h",
                "day"
              ]
            }
          },
          "required": [
            "kind",
            "unit"
          ],
          "additionalProperties": false
        }
      ]
    },
    "Field": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "urn:aeliqo:reference:0.1:types#/$defs/Id"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "type": {
          "enum": [
            "string",
            "boolean",
            "integer",
            "number",
            "decimal",
            "date",
            "datetime"
          ]
        },
        "role": {
          "enum": [
            "key",
            "dimension",
            "measure",
            "time"
          ]
        },
        "nullable": {
          "type": "boolean"
        },
        "unit": {
          "$ref": "urn:aeliqo:reference:0.1:types#/$defs/Unit"
        },
        "entity": {
          "$ref": "urn:aeliqo:reference:0.1:types#/$defs/Id"
        },
        "aggregation": {
          "enum": [
            "none",
            "sum",
            "min",
            "max",
            "count",
            "mean"
          ]
        },
        "timezone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "grain": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        }
      },
      "required": [
        "id",
        "label",
        "type",
        "role",
        "nullable"
      ],
      "additionalProperties": false
    },
    "MetricExpr": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "aggregate"
            },
            "fn": {
              "enum": [
                "sum",
                "count",
                "min",
                "max",
                "mean"
              ]
            },
            "field": {
              "$ref": "urn:aeliqo:reference:0.1:types#/$defs/Id"
            }
          },
          "required": [
            "kind",
            "fn",
            "field"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "ratio"
            },
            "numerator": {
              "$ref": "urn:aeliqo:reference:0.1:types#/$defs/MetricExpr"
            },
            "denominator": {
              "$ref": "urn:aeliqo:reference:0.1:types#/$defs/MetricExpr"
            },
            "zeroDenominator": {
              "enum": [
                "null",
                "error"
              ]
            }
          },
          "required": [
            "kind",
            "numerator",
            "denominator",
            "zeroDenominator"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "weightedMean"
            },
            "valueField": {
              "$ref": "urn:aeliqo:reference:0.1:types#/$defs/Id"
            },
            "weightField": {
              "$ref": "urn:aeliqo:reference:0.1:types#/$defs/Id"
            },
            "zeroWeight": {
              "enum": [
                "null",
                "error"
              ]
            }
          },
          "required": [
            "kind",
            "valueField",
            "weightField",
            "zeroWeight"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "registered"
            },
            "metricId": {
              "$ref": "urn:aeliqo:reference:0.1:types#/$defs/Id"
            },
            "config": {
              "$ref": "urn:aeliqo:reference:0.1:types#/$defs/Props"
            }
          },
          "required": [
            "kind",
            "metricId",
            "config"
          ],
          "additionalProperties": false
        }
      ]
    },
    "Metric": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "urn:aeliqo:reference:0.1:types#/$defs/Id"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "unit": {
          "$ref": "urn:aeliqo:reference:0.1:types#/$defs/Unit"
        },
        "expression": {
          "$ref": "urn:aeliqo:reference:0.1:types#/$defs/MetricExpr"
        },
        "nullPolicy": {
          "enum": [
            "propagate",
            "ignore-with-coverage",
            "error"
          ]
        }
      },
      "required": [
        "id",
        "label",
        "unit",
        "expression",
        "nullPolicy"
      ],
      "additionalProperties": false
    },
    "Relation": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "urn:aeliqo:reference:0.1:types#/$defs/Id"
        },
        "fromFields": {
          "type": "array",
          "items": {
            "$ref": "urn:aeliqo:reference:0.1:types#/$defs/Id"
          },
          "minItems": 1,
          "maxItems": 8
        },
        "toDataset": {
          "$ref": "urn:aeliqo:reference:0.1:types#/$defs/Id"
        },
        "toFields": {
          "type": "array",
          "items": {
            "$ref": "urn:aeliqo:reference:0.1:types#/$defs/Id"
          },
          "minItems": 1,
          "maxItems": 8
        },
        "cardinality": {
          "enum": [
            "one-to-one",
            "one-to-many",
            "many-to-one",
            "many-to-many"
          ]
        },
        "joinPolicy": {
          "enum": [
            "lookup",
            "explicit-aggregation-required"
          ]
        }
      },
      "required": [
        "id",
        "fromFields",
        "toDataset",
        "toFields",
        "cardinality",
        "joinPolicy"
      ],
      "additionalProperties": false
    },
    "QueryCapabilities": {
      "type": "object",
      "properties": {
        "filter": {
          "type": "boolean"
        },
        "sort": {
          "type": "boolean"
        },
        "aggregate": {
          "type": "boolean"
        },
        "search": {
          "type": "boolean"
        },
        "paging": {
          "enum": [
            "none",
            "cursor",
            "offset"
          ]
        },
        "maxRows": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        }
      },
      "required": [
        "filter",
        "sort",
        "aggregate",
        "search",
        "paging",
        "maxRows"
      ],
      "additionalProperties": false
    },
    "Dataset": {
      "type": "object",
      "properties": {
        "contractVersion": {
          "const": "0.1"
        },
        "id": {
          "$ref": "urn:aeliqo:reference:0.1:types#/$defs/Id"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "entity": {
          "$ref": "urn:aeliqo:reference:0.1:types#/$defs/Id"
        },
        "descriptorRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "key": {
          "type": "array",
          "items": {
            "$ref": "urn:aeliqo:reference:0.1:types#/$defs/Id"
          },
          "minItems": 1,
          "maxItems": 8
        },
        "grain": {
          "type": "array",
          "items": {
            "$ref": "urn:aeliqo:reference:0.1:types#/$defs/Id"
          },
          "minItems": 1,
          "maxItems": 8
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "urn:aeliqo:reference:0.1:types#/$defs/Field"
          },
          "minItems": 1,
          "maxItems": 256
        },
        "metrics": {
          "type": "array",
          "items": {
            "$ref": "urn:aeliqo:reference:0.1:types#/$defs/Metric"
          },
          "minItems": 0,
          "maxItems": 128
        },
        "relations": {
          "type": "array",
          "items": {
            "$ref": "urn:aeliqo:reference:0.1:types#/$defs/Relation"
          },
          "minItems": 0,
          "maxItems": 64
        },
        "capabilities": {
          "$ref": "urn:aeliqo:reference:0.1:types#/$defs/QueryCapabilities"
        }
      },
      "required": [
        "contractVersion",
        "id",
        "label",
        "entity",
        "descriptorRevision",
        "key",
        "grain",
        "fields",
        "metrics",
        "relations",
        "capabilities"
      ],
      "additionalProperties": false
    },
    "Scalar": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 0,
          "maxLength": 1024
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        }
      ]
    },
    "Predicate": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "compare"
            },
            "field": {
              "$ref": "urn:aeliqo:reference:0.1:types#/$defs/Id"
            },
            "operator": {
              "enum": [
                "eq",
                "ne",
                "lt",
                "lte",
                "gt",
                "gte"
              ]
            },
            "value": {
              "$ref": "urn:aeliqo:reference:0.1:types#/$defs/Scalar"
            }
          },
          "required": [
            "kind",
            "field",
            "operator",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "in"
            },
            "field": {
              "$ref": "urn:aeliqo:reference:0.1:types#/$defs/Id"
            },
            "values": {
              "type": "array",
              "items": {
                "$ref": "urn:aeliqo:reference:0.1:types#/$defs/Scalar"
              },
              "minItems": 1,
              "maxItems": 100
            },
            "negated": {
              "type": "boolean"
            }
          },
          "required": [
            "kind",
            "field",
            "values",
            "negated"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "range"
            },
            "field": {
              "$ref": "urn:aeliqo:reference:0.1:types#/$defs/Id"
            },
            "lower": {
              "$ref": "urn:aeliqo:reference:0.1:types#/$defs/Scalar"
            },
            "upper": {
              "$ref": "urn:aeliqo:reference:0.1:types#/$defs/Scalar"
            },
            "lowerInclusive": {
              "type": "boolean"
            },
            "upperInclusive": {
              "type": "boolean"
            }
          },
          "required": [
            "kind",
            "field",
            "lower",
            "upper",
            "lowerInclusive",
            "upperInclusive"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "isNull"
            },
            "field": {
              "$ref": "urn:aeliqo:reference:0.1:types#/$defs/Id"
            },
            "negated": {
              "type": "boolean"
            }
          },
          "required": [
            "kind",
            "field",
            "negated"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "and"
            },
            "items": {
              "type": "array",
              "items": {
                "$ref": "urn:aeliqo:reference:0.1:types#/$defs/Predicate"
              },
              "minItems": 1,
              "maxItems": 32
            }
          },
          "required": [
            "kind",
            "items"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "or"
            },
            "items": {
              "type": "array",
              "items": {
                "$ref": "urn:aeliqo:reference:0.1:types#/$defs/Predicate"
              },
              "minItems": 1,
              "maxItems": 32
            }
          },
          "required": [
            "kind",
            "items"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "not"
            },
            "item": {
              "$ref": "urn:aeliqo:reference:0.1:types#/$defs/Predicate"
            }
          },
          "required": [
            "kind",
            "item"
          ],
          "additionalProperties": false
        }
      ]
    },
    "Query": {
      "type": "object",
      "properties": {
        "select": {
          "type": "array",
          "items": {
            "$ref": "urn:aeliqo:reference:0.1:types#/$defs/Id"
          },
          "minItems": 1,
          "maxItems": 64
        },
        "where": {
          "$ref": "urn:aeliqo:reference:0.1:types#/$defs/Predicate"
        },
        "sort": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "field": {
                "$ref": "urn:aeliqo:reference:0.1:types#/$defs/Id"
              },
              "direction": {
                "enum": [
                  "asc",
                  "desc"
                ]
              },
              "nulls": {
                "enum": [
                  "first",
                  "last"
                ]
              }
            },
            "required": [
              "field",
              "direction",
              "nulls"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 8
        },
        "groupBy": {
          "type": "array",
          "items": {
            "$ref": "urn:aeliqo:reference:0.1:types#/$defs/Id"
          },
          "minItems": 0,
          "maxItems": 8
        },
        "metrics": {
          "type": "array",
          "items": {
            "$ref": "urn:aeliqo:reference:0.1:types#/$defs/Id"
          },
          "minItems": 0,
          "maxItems": 16
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "cursor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        }
      },
      "required": [
        "select",
        "limit"
      ],
      "additionalProperties": false
    },
    "Scope": {
      "type": "object",
      "properties": {
        "population": {
          "enum": [
            "complete",
            "query",
            "page",
            "sample"
          ]
        },
        "coverage": {
          "enum": [
            "complete",
            "partial",
            "unknown"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "population",
        "coverage",
        "label"
      ],
      "additionalProperties": false
    },
    "Binding": {
      "type": "object",
      "properties": {
        "datasetId": {
          "$ref": "urn:aeliqo:reference:0.1:types#/$defs/Id"
        },
        "query": {
          "$ref": "urn:aeliqo:reference:0.1:types#/$defs/Query"
        },
        "scope": {
          "$ref": "urn:aeliqo:reference:0.1:types#/$defs/Scope"
        }
      },
      "required": [
        "datasetId",
        "query",
        "scope"
      ],
      "additionalProperties": false
    },
    "ComponentRef": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "urn:aeliqo:reference:0.1:types#/$defs/Id"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        }
      },
      "required": [
        "id",
        "version"
      ],
      "additionalProperties": false
    },
    "Port": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "urn:aeliqo:reference:0.1:types#/$defs/Id"
        },
        "direction": {
          "enum": [
            "input",
            "output"
          ]
        },
        "event": {
          "enum": [
            "selection",
            "highlight",
            "filter",
            "inspect"
          ]
        },
        "entity": {
          "$ref": "urn:aeliqo:reference:0.1:types#/$defs/Id"
        }
      },
      "required": [
        "id",
        "direction",
        "event"
      ],
      "additionalProperties": false
    },
    "Manifest": {
      "type": "object",
      "properties": {
        "contractVersion": {
          "const": "0.1"
        },
        "component": {
          "$ref": "urn:aeliqo:reference:0.1:types#/$defs/ComponentRef"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "level": {
          "enum": [
            "primitive",
            "compound",
            "workspace"
          ]
        },
        "tasks": {
          "type": "array",
          "items": {
            "$ref": "urn:aeliqo:reference:0.1:types#/$defs/Id"
          },
          "minItems": 1,
          "maxItems": 24
        },
        "propsSchemaId": {
          "$ref": "urn:aeliqo:reference:0.1:types#/$defs/Id"
        },
        "loaderKey": {
          "$ref": "urn:aeliqo:reference:0.1:types#/$defs/Id"
        },
        "ports": {
          "type": "array",
          "items": {
            "$ref": "urn:aeliqo:reference:0.1:types#/$defs/Port"
          },
          "minItems": 0,
          "maxItems": 24
        },
        "requiredCapabilities": {
          "type": "array",
          "items": {
            "$ref": "urn:aeliqo:reference:0.1:types#/$defs/Id"
          },
          "minItems": 0,
          "maxItems": 24
        },
        "variants": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "urn:aeliqo:reference:0.1:types#/$defs/Id"
              },
              "minInlineSize": {
                "type": "integer",
                "minimum": 0,
                "maximum": 8192
              },
              "preservesTask": {
                "const": true
              }
            },
            "required": [
              "id",
              "minInlineSize",
              "preservesTask"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 16
        },
        "fallback": {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "table",
                "list",
                "text",
                "unsupported"
              ]
            },
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          },
          "required": [
            "kind",
            "label"
          ],
          "additionalProperties": false
        },
        "lifecycle": {
          "type": "object",
          "properties": {
            "preserveDraft": {
              "type": "boolean"
            },
            "preserveSelection": {
              "const": true
            },
            "supportsReducedMotion": {
              "const": true
            },
            "keyboardAlternative": {
              "const": true
            }
          },
          "required": [
            "preserveDraft",
            "preserveSelection",
            "supportsReducedMotion",
            "keyboardAlternative"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "contractVersion",
        "component",
        "label",
        "level",
        "tasks",
        "propsSchemaId",
        "loaderKey",
        "ports",
        "requiredCapabilities",
        "variants",
        "fallback",
        "lifecycle"
      ],
      "additionalProperties": false
    },
    "NodePolicy": {
      "type": "object",
      "properties": {
        "pinned": {
          "type": "boolean"
        },
        "allowVariantAdaptation": {
          "type": "boolean"
        },
        "allowDataTransform": {
          "type": "boolean"
