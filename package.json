{
  "name": "aeliqo-v0-1-0-master-foundation",
  "private": true,
  "version": "0.1.0-dev.0",
  "description": "Aeliqo rewrite specification and delivery harness; not a published UI runtime",
  "scripts": {
    "kit:check": "python3 scripts/kit_check.py",
    "check": "python3 scripts/gate.py ci",
    "release:check": "python3 scripts/gate.py release",
    "kit:test": "python3 scripts/validate_all.py",
    "kit:reference": "python3 scripts/test_reference.py",
    "typecheck": "pnpm build:platform && tsc --project tsconfig.json",
    "build:platform": "pnpm --filter @aeliqo/web build && pnpm --filter @aeliqo/react build",
    "test:platform": "vitest run --config tests/platform/vitest.config.mjs",
    "test:platform:browser": "pnpm build:platform && playwright test --config tests/platform/playwright.config.mjs",
    "test:platform:consumers": "node tests/consumers/platform-tarballs.mjs",
    "test:next-platform": "pnpm --filter @aeliqo/web build && pnpm --filter @aeliqo/next-platform-fixture build && playwright test --config tests/next-platform/playwright.config.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@lit-labs/ssr": "4.1.0",
    "@lit-labs/ssr-client": "1.1.8",
    "@lit/react": "1.0.8",
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "lit": "3.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "5.0.0",
    "vue": "3.5.42"
  },
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": "24.20.0",
    "pnpm": "11.24.0"
  }
}
